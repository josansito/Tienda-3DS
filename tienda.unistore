    {
      "info": {
        "title": "Mi Aplicacion Propia",
        "author": "Tu Nombre",
        "description": "Tu app homebrew personalizada. Se instalara directamente en el menu HOME.",
        "category": ["Apps"]
      },
      "script": [
        {
          "type": "downloadFile",
          "file": "%URL%",
          "output": "sdmc:/tienda_temp.cia"
        },
        {
          "type": "installCia",
          "file": "sdmc:/tienda_temp.cia"
        },
        {
          "type": "deleteFile",
          "file": "sdmc:/tienda_temp.cia"
        }
      ],
      "attachments": [
        "https://githubusercontent.com"
      ]
    },
    {
      "info": {
        "title": "Juego Ejemplo NDS",
        "author": "Desarrollador",
        "description": "Juego de Nintendo DS. Se guardara en la carpeta para TWiLight Menu++.",
        "category": ["NDS"]
      },
      "script": [
        {
          "type": "downloadFile",
          "file": "%URL%",
          "output": "sdmc:/roms/nds/juego_ejemplo.nds"
        }
      ],
      "attachments": [
        "https://githubusercontent.com"
      ]
    },
    {
      "info": {
        "title": "Pokémon Quetzal 0.8.4 Español",
