  "storeContent": [
    {
      "info": {
        "title": "Mi Aplicacion Propia",
        "author": "Tu Nombre",
        "description": "Tu app homebrew personalizada. Se instalará directamente en el menú HOME.",
        "category": ["Apps"],
        "icon": "https://githubusercontent.com"
      },
      "script": [
        {
          "type": "downloadRelease",
          "repository": "josansito/Tienda-3DS",
          "tag": "V1.0.0",
          "file": "mi_app.cia",
          "output": "sdmc:/tienda_temp.cia"
        },
        {
          "type": "installCia",
          "file": "/tienda_temp.cia"
        },
        {
          "type": "deleteFile",
          "file": "sdmc:/tienda_temp.cia"
        }
      ]
    },
    {
      "info": {
        "title": "Pokémon Quetzal 0.8.4 Español",
